{"files":[{"text":"`timescale 1ns\/1ps\n\nmodule counter (\n    input  wire       clk,\n    input  wire       reset,\n    output logic [3:0] count\n);\n    always_ff @(posedge clk) begin\n        if (reset)\n            count <= 4'd0;\n        else\n            count <= count + 1'b1;\n    end\nendmodule\n","role":"Design","name":"counter.sv","id":"B45008FE-CAF0-4EBC-953A-2806672B3100"},{"id":"2AFAC3F1-D445-49C8-B85D-1449B83E4D68","name":"counter_tb.sv","role":"Testbench","text":"`timescale 1ns\/1ps\n\nmodule counter_tb;\n    reg clk = 0;\n    reg reset = 1;\n    wire [3:0] count;\n    integer i;\n\n    counter dut (.clk(clk), .reset(reset), .count(count));\n    always #5 clk = ~clk;\n\n    initial begin\n        #6;\n        if (count !== 0) $fatal(1, \"reset failed\");\n        reset = 0;\n        for (i = 1; i <= 5; i = i + 1) begin\n            @(posedge clk);\n            #1;\n            if (count !== i) $fatal(1, \"count mismatch\");\n        end\n        $display(\"PASS: reset and five rising edges\");\n        $finish;\n    end\nendmodule\n"}],"designTop":"counter","simulationTop":"counter_tb","version":1,"duration":100}